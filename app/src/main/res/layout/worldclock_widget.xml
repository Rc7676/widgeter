<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/wc_city"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/worldclock_title"
        android:textColor="@color/widget_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextClock
        android:id="@+id/wc_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:textColor="@color/widget_on_card"
        android:textSize="38sp"
        android:textStyle="bold"
        android:letterSpacing="-0.02" />

    <TextClock
        android:id="@+id/wc_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEE, MMM d"
        android:format24Hour="EEE, MMM d"
        android:textColor="@color/widget_on_card_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/wc_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/worldclock_hint"
        android:textColor="@color/widget_on_card_muted"
        android:textSize="10sp" />

</LinearLayout>
