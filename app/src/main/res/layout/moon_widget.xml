<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/moon_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical">

    <TextView
        android:fontFamily="@font/manrope_family"
        android:id="@+id/moon_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/moon_title"
        android:textColor="@color/widget_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.10"
        android:textAllCaps="true" />

    <TextView
        android:fontFamily="@font/sora_family"
        android:id="@+id/moon_emoji"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="🌕"
        android:textSize="46sp" />

    <TextView
        android:fontFamily="@font/manrope_family"
        android:id="@+id/moon_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/moon_title"
        android:textColor="@color/widget_on_card"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:fontFamily="@font/manrope_family"
        android:id="@+id/moon_illum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_on_card_muted"
        android:textSize="11sp" />

</LinearLayout>
