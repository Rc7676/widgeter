<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pomo_label"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/pomodoro_title"
            android:textColor="@color/widget_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/pomo_phase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="Focus"
            android:textColor="@color/widget_on_accent_container"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/pomo_chrono"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/widget_on_card"
        android:textSize="30sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pomo_count"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="🍅 0"
            android:textColor="@color/widget_on_card_muted"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/pomo_toggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/tonal_circle"
            android:padding="11dp"
            android:src="@drawable/ic_play"
            android:tint="@color/widget_on_accent_container"
            android:contentDescription="@string/start_pause" />

        <ImageView
            android:id="@+id/pomo_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/tonal_circle"
            android:padding="11dp"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/widget_on_accent_container"
            android:contentDescription="@string/pomodoro_skip" />
    </LinearLayout>

</LinearLayout>
