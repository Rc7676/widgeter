<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/todo_title"
            android:textColor="@color/widget_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/todo_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/widget_on_card_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/todo_add"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/tonal_circle"
            android:padding="5dp"
            android:src="@drawable/ic_add"
            android:tint="@color/widget_on_accent_container"
            android:contentDescription="@string/cd_add" />
    </LinearLayout>

    <ListView
        android:id="@+id/todo_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <TextView
        android:id="@+id/todo_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/todo_empty"
        android:textColor="@color/widget_on_card_muted"
        android:textSize="14sp" />

</LinearLayout>
