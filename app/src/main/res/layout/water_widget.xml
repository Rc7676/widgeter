<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical">

    <TextView
        android:id="@+id/water_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/water_title"
        android:textColor="@color/widget_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.10"
        android:textAllCaps="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/water_minus"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/tonal_circle"
            android:padding="12dp"
            android:src="@drawable/ic_minus"
            android:tint="@color/widget_on_accent_container"
            android:contentDescription="@string/cd_remove" />

        <TextView
            android:id="@+id/water_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0/8"
            android:textColor="@color/widget_on_card"
            android:textSize="36sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/water_plus"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/tonal_circle"
            android:padding="12dp"
            android:src="@drawable/ic_add"
            android:tint="@color/widget_on_accent_container"
            android:contentDescription="@string/cd_add" />

    </LinearLayout>

</LinearLayout>
