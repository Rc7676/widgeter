<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/page_more_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="24dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp">

        <!-- HABITS -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout style="@style/CardInner">
                <LinearLayout style="@style/CardHeader">
                    <ImageView style="@style/CardHeaderIcon" android:src="@drawable/ic_check_on" />
                    <TextView
                        style="@style/CardHeaderText"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/habits_title" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/habit_add_btn"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add"
                        app:icon="@drawable/ic_add" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/habits_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/habits_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="@string/habits_empty"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- WATER -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout style="@style/CardInner">
                <LinearLayout style="@style/CardHeader">
                    <ImageView style="@style/CardHeaderIcon" android:src="@drawable/ic_counter" />
                    <TextView
                        style="@style/CardHeaderText"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/water_title" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/water_add_btn"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add"
                        app:icon="@drawable/ic_add" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/waters_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/waters_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="@string/waters_empty"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- COUNTDOWNS -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout style="@style/CardInner">
                <LinearLayout style="@style/CardHeader">
                    <ImageView style="@style/CardHeaderIcon" android:src="@drawable/ic_calendar" />
                    <TextView
                        style="@style/CardHeaderText"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/countdowns_title" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/countdown_add_btn"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add"
                        app:icon="@drawable/ic_add" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/countdowns_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/countdowns_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="@string/countdowns_empty"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CALENDAR -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout style="@style/CardInner">
                <LinearLayout style="@style/CardHeader">
                    <ImageView style="@style/CardHeaderIcon" android:src="@drawable/ic_calendar" />
                    <TextView style="@style/CardHeaderText" android:text="@string/calendar_title" />
                </LinearLayout>

                <CalendarView
                    android:id="@+id/calendar_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/more_widgets_btn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/gallery_title"
            app:icon="@drawable/ic_more" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/more_settings_btn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_title"
            app:icon="@drawable/ic_settings" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
