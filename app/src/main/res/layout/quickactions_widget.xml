<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qa_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical">

    <TextView
        android:fontFamily="@font/manrope_family"
        android:id="@+id/qa_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/quickactions_title"
        android:textColor="@color/widget_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.10"
        android:textAllCaps="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/qa_note"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/tonal_circle"
                android:padding="8dp"
                android:src="@drawable/ic_note"
                android:tint="@color/widget_on_accent_container"
                android:contentDescription="@string/sc_note_short" />

            <TextView
        android:fontFamily="@font/manrope_family"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/qa_note"
                android:textColor="@color/widget_on_card"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/qa_task"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/tonal_circle"
                android:padding="8dp"
                android:src="@drawable/ic_checklist"
                android:tint="@color/widget_on_accent_container"
                android:contentDescription="@string/sc_task_short" />

            <TextView
        android:fontFamily="@font/manrope_family"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/qa_task"
                android:textColor="@color/widget_on_card"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/qa_counter"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/tonal_circle"
                android:padding="8dp"
                android:src="@drawable/ic_counter"
                android:tint="@color/widget_on_accent_container"
                android:contentDescription="@string/new_counter" />

            <TextView
        android:fontFamily="@font/manrope_family"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/qa_counter"
                android:textColor="@color/widget_on_card"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
