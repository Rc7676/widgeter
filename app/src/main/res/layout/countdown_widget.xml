<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/countdown_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clock_bg"
    android:orientation="vertical"
    android:gravity="center_vertical">

    <TextView
        android:fontFamily="@font/manrope_family"
        android:id="@+id/countdown_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/countdown_title"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:alpha="0.9"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:fontFamily="@font/sora_family"
        android:id="@+id/countdown_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="#FFFFFF"
        android:textSize="44sp"
        android:textStyle="bold" />

    <TextView
        android:fontFamily="@font/manrope_family"
        android:id="@+id/countdown_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/countdown_set"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:alpha="0.9" />

    <TextView
        android:fontFamily="@font/manrope_family"
        android:id="@+id/countdown_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:alpha="0.75"
        android:visibility="gone" />

</LinearLayout>
