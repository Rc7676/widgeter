<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clock_bg"
    android:orientation="vertical"
    android:gravity="center">

    <TextClock
        android:fontFamily="@font/sora_family"
        android:id="@+id/clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold"
        android:letterSpacing="-0.02" />

    <TextClock
        android:fontFamily="@font/manrope_family"
        android:id="@+id/clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="MMM d"
        android:format24Hour="MMM d"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:alpha="0.85" />

</LinearLayout>
