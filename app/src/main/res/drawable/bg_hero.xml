<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base blue → teal → green gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="?attr/heroGradStart"
                android:centerColor="?attr/heroGradMid"
                android:endColor="?attr/heroGradEnd"
                android:angle="135" />
            <corners android:radius="34dp" />
        </shape>
    </item>
    <!-- Soft glass highlight, top-right -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF"
                android:centerX="0.82"
                android:centerY="0.12"
                android:gradientRadius="220dp" />
            <corners android:radius="34dp" />
        </shape>
    </item>
    <!-- Subtle depth wash, bottom-left -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:startColor="#22000000"
                android:endColor="#00000000"
                android:centerX="0.1"
                android:centerY="0.95"
                android:gradientRadius="260dp" />
            <corners android:radius="34dp" />
        </shape>
    </item>
</layer-list>
